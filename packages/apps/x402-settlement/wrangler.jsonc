{
  "name": "x402-settlement",
  "main": "./src/index.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat_v2"],
  "dev": {
    "port": 8792,
    "local_protocol": "http",
  },
  "observability": {
    "enabled": true,
  },
  // Top-level bindings needed for vitest (@cloudflare/vitest-pool-workers)
  "vars": {
    "CANOPY_ID": "canopy-dev-1",
    "NODE_ENV": "dev",
    "DO_SHARD_COUNT": "4",
    // Testnet facilitator: credential-free, so the settlement rail can be
    // exercised end-to-end without CDP keys (FOR-79). Both lanes run Base
    // Sepolia today. Switch to the CDP facilitator
    // (https://api.cdp.coinbase.com/platform/v2/x402) as part of the FOR-83
    // mainnet cutover, at which point CDP credentials become required.
    "X402_FACILITATOR_URL": "https://x402.org/facilitator",
    "X402_NETWORK": "eip155:84532",
    "SETTLE_TIMEOUT_MS": "5000",
    // Accrual indexer (plan-2607-43 slice 03). Observe-only until slice 04.
    "SUPPORTED_CHAINS_RPC": "{\"84532\":[\"https://sepolia.base.org\"]}",
    "ENFORCEMENT_ARMED": "false",
    "CANOPY_API_ORIGIN": "",
    "STARTER_CREDITS": "0",
  },
  // Reservation registry, read-only by convention (writer: canopy-api).
  "r2_buckets": [
    {
      "binding": "R2_GRANTS",
      "bucket_name": "canopy-dev-1-grants",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "X402_SETTLEMENT_DO",
        "class_name": "X402SettlementDO",
      },
      // Pipe-fee receivables, one instance per liable account (ADR-0058 §5).
      {
        "name": "RECEIVABLES_DO",
        "class_name": "ReceivablesDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["X402SettlementDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ReceivablesDO"],
    },
  ],
  "env": {
    "dev": {
      "name": "x402-settlement-dev",
      "vars": {
        "CANOPY_ID": "canopy-dev-1",
        "NODE_ENV": "dev",
        "DO_SHARD_COUNT": "4",
        // Dev uses the credential-free testnet facilitator so the rail can be
        // proven end-to-end without CDP keys (FOR-79). CDP credentials are
        // still pushed by deploy-workers.yml and reported by /health, so the
        // credential path stays exercised — it is just not load-bearing here.
        "X402_FACILITATOR_URL": "https://x402.org/facilitator",
        "X402_NETWORK": "eip155:84532",
        "SETTLE_TIMEOUT_MS": "5000",
        "SUPPORTED_CHAINS_RPC": "{\"84532\":[\"https://sepolia.base.org\"]}",
        "ENFORCEMENT_ARMED": "false",
        "CANOPY_API_ORIGIN": "",
        "STARTER_CREDITS": "0",
      },
      // Accrual indexer sweep (slice 03); resumable, so cadence is a
      // freshness knob, not a correctness one.
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "r2_buckets": [
        {
          "binding": "R2_GRANTS",
          // PLACEHOLDER: rewritten from R2_GRANTS_BUCKET_NAME at deploy
          // (scripts/apply-runtime-contract.mjs), mirroring canopy-api.
          "bucket_name": "canopy-dev-1-grants",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "forest-2-x402-settlement-a",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            // No DLQ/retries - always ack, failures tracked in auth_state
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "X402_SETTLEMENT_DO",
            "class_name": "X402SettlementDO",
          },
          {
            "name": "RECEIVABLES_DO",
            "class_name": "ReceivablesDO",
          },
        ],
      },
    },
    "prod": {
      "name": "x402-settlement-prod",
      "vars": {
        "CANOPY_ID": "canopy-prod-1",
        "NODE_ENV": "prod",
        "DO_SHARD_COUNT": "4",
        // Lane B is "stage" — no production lane exists and both lanes settle on
        // Base Sepolia. Must stay in lockstep with canopy-api's env prod X402_*
        // vars: canopy-api builds the 402 challenge, this worker settles it, and
        // a mismatch fails at settle time (plan-2607-39 D1).
        //
        // apply-runtime-contract.mjs rewrites name, queue names, CANOPY_ID,
        // X402_NETWORK, X402_FACILITATOR_URL, SUPPORTED_CHAINS_RPC and the
        // R2_GRANTS bucket at deploy; remaining literals deploy verbatim.
        "X402_FACILITATOR_URL": "https://x402.org/facilitator",
        "X402_NETWORK": "eip155:84532",
        "SETTLE_TIMEOUT_MS": "5000",
        // SUPPORTED_CHAINS_RPC deliberately absent: injected at deploy from
        // the environment (apply-runtime-contract.mjs), as canopy-api does.
        "ENFORCEMENT_ARMED": "false",
        "CANOPY_API_ORIGIN": "",
        "STARTER_CREDITS": "0",
      },
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "r2_buckets": [
        {
          "binding": "R2_GRANTS",
          // PLACEHOLDER: rewritten from R2_GRANTS_BUCKET_NAME at deploy.
          "bucket_name": "canopy-prod-1-grants",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "forest-2-x402-settlement-b",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            // No DLQ/retries - always ack, failures tracked in auth_state
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "X402_SETTLEMENT_DO",
            "class_name": "X402SettlementDO",
          },
          {
            "name": "RECEIVABLES_DO",
            "class_name": "ReceivablesDO",
          },
        ],
      },
    },
  },
}
