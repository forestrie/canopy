{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "forestrie-agents": {
      "source": {
        "source": "github",
        "repo": "forestrie/forestrie-agents"
      }
    }
  },
  "enabledPlugins": {
    "forestrie-core@forestrie-agents": true,
    "mattpocock-skills@forestrie-agents": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/probe-plugin-install.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
