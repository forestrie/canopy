{
  // Univocity release ranges for the bootstrap suite's ephemeral provision.
  //
  // WHY A FILE AND NOT A DEFAULT IN THE TASKFILE. These were `v0.6.0`
  // hardcoded as a `${VAR:-default}` fallback in two places, and the contract
  // release was not pinned at all: `cart fetch-release` defaults to whatever
  // is latest. A default that nobody bumps goes stale silently, and an
  // unpinned "latest" changes what CI exercises without a commit saying so.
  //
  // RANGE WITHIN ONE MINOR. Each value is a range inside a single 0.x minor.
  // Every run resolves it (scripts/univocity-pin.mjs) to the highest matching
  // non-prerelease release of the repo and logs the resolved tag, so patch
  // releases flow in without a canopy PR. A range that matches no release
  // fails the run; it never falls back to latest. The same rule applies to
  // lanes in release-orchestrator's config/template-v3.jsonc.
  //
  // A MINOR BUMP IS A PR. For these 0.x packages a minor release carries ABI
  // or signing changes (see the contract history below), so moving a range to
  // the next minor is a change here: edit the range, let the suite run, and
  // the diff records that the new minor was exercised.
  //
  // Range syntax: a lower bound (>= or >) and an exclusive upper bound (<),
  // both over X.Y.Z and inside one major.minor, e.g. ">=0.4.0 <0.5.0". Any
  // other shape is refused.
  //
  // The contract release matters more than it looks. Univocity contracts are
  // IMMUTABLE, so a forest deployed against a buggy release keeps the bug:
  // v0.1.7 and earlier reverted on a lone-peak grant leaf, which made the
  // demo deck fail deterministically on a parity coin flip. v0.1.8 fixed it.
  "schemaVersion": 2,
  // forestrie/univocity-tools releases supplying `deployer` + `contract-artefacts`.
  "tools": ">=0.8.3 <0.9.0",
  // forestrie/univocity contract releases the ephemeral instances are deployed from.
  // v0.2.0: ALG_ES256_WEBAUTHN + DelegationProof.algData ABI change (ADR-0008);
  // publishCheckpoint selector 87ce4c61 -> 295e6ade.
  // v0.3.0: signed checkpoint tree size (ADR-0066): the receipt's protected
  // header must carry tree-size-2 (-65933) as deterministic CBOR and match
  // the stored size; size-driven consistency fold. No ABI change. Receipts
  // from a sealer older than arbor #102 are rejected.
  // v0.4.0: verifyKS256Raw refuses high-s (s > (n-1)/2); the consistency
  // library refuses malformed proofs with distinct errors. ABI adds one error.
  "contracts": ">=0.4.0 <0.5.0",
}
